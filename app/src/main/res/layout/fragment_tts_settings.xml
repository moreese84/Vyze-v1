<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tts_settings_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="yes" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tts_settings_subtitle"
            android:textSize="16sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="24dp" />

        <!-- Language Selector -->
        <TextView
            android:id="@+id/label_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_language"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/value_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="English"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_language"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFD700"
            android:minHeight="48dp"
            android:contentDescription="Speech language selector"
            android:layout_marginBottom="32dp" />

        <!-- Speech Rate -->

        <!-- Speech Rate -->
        <TextView
            android:id="@+id/label_speech_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_speech_speed"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/value_speech_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/slider_speech_rate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:max="150"
            android:progress="50"
            android:progressTint="#FFD700"
            android:thumbTint="#FFD700"
            android:minHeight="48dp"
            android:contentDescription="Speech speed slider, current value 1.0"
            android:layout_marginBottom="32dp" />

        <!-- Pitch -->
        <TextView
            android:id="@+id/label_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_voice_pitch"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/value_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.0"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/slider_pitch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#FFD700"
            android:thumbTint="#FFD700"
            android:minHeight="48dp"
            android:contentDescription="Voice pitch slider, current value 1.0"
            android:layout_marginBottom="32dp" />

        <!-- Volume -->
        <TextView
            android:id="@+id/label_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_audio_volume"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/value_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/slider_volume"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:max="100"
            android:progress="80"
            android:progressTint="#FFD700"
            android:thumbTint="#FFD700"
            android:minHeight="48dp"
            android:contentDescription="Audio volume slider, current value 80 percent"
            android:layout_marginBottom="40dp" />

        <!-- Test Button -->
        <Button
            android:id="@+id/btn_test_voice"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/tts_test_voice"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:textColor="@android:color/black"
            android:contentDescription="Tap to hear a sample with current voice settings"
            android:layout_marginBottom="24dp" />

        <!-- Voice Picker -->
        <TextView
            android:id="@+id/label_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_voice"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/value_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_voice_automatic"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_voice_prev"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/tts_voice_prev"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:textColor="@android:color/black"
            android:contentDescription="Previous voice. Tap to hear the previous voice speak a sample"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_voice_next"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/tts_voice_next"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:textColor="@android:color/black"
            android:contentDescription="Next voice. Tap to hear the next voice speak a sample"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_voice_use"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/tts_voice_use"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#00CC88"
            android:textColor="@android:color/white"
            android:contentDescription="Use the voice you just heard"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Night Mode Toggle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/night_mode_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/value_night_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/night_mode_system"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_night_mode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFD700"
            android:minHeight="48dp"
            android:contentDescription="Theme selector: light, dark, or system"
            android:layout_marginBottom="32dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Diagnostics (placebo mode/tutorial buttons removed 2026-11-09,
             audit #46: they announced modes that do not exist) -->
        <Button
            android:id="@+id/btn_error_log"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/error_log_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#555555"
            android:textColor="@android:color/white"
            android:contentDescription="View error log for diagnostics"
            android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>
