<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hardware features (required=false so the app installs on devices without them) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Declare permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Read-only network-state check: lets the app detect offline mode and
         strip the cloud-only recognizer extras (language auto-detect) that
         fail without connectivity. No data leaves the device. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- File access for model loading from public Downloads directory (Android 10 and below) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Android 11+ all-files access for reading model from Downloads -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 13+ granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".VyzeApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:taskAffinity="">

        <!-- LiteRT-LM GPU backend native libraries -->
        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>

        <!-- Enable LiteRT-LM GPU execution for Gemma 3n E2B -->
        <meta-data
            android:name="com.google.ai.edge.litertlm.gpu"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:rotationAnimation="seamless"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.Starting"
            tools:targetApi="O">

            <!-- Main app intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Declare notch support -->
            <meta-data
                android:name="android.notch_support"
                android:value="true" />

        </activity>



    </application>

</manifest>
