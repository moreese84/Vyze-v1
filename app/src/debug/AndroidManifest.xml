<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-ONLY manifest additions (src/debug source set).

    Nothing in this file merges into the release variant: no INTERNET
    permission, no extra components — the release APK stays 100% offline
    by construction. The receiver exists solely so a development machine
    can pull recorded transcripts for the Jev harness:

        adb shell am broadcast \
            -n com.vyze.app/.debug.InteractionLogExportReceiver

    The provider auto-exports the same transcripts to PUBLIC Downloads at
    every cold app start, for users who move files by USB transfer
    (no adb). It is a no-op without the storage grant.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            exported=true is deliberate: it only exists in debug builds and
            the receiver's only effect is a local-file export. Explicit
            component targeting required (no intent-filter — no implicit
            pickup by any other app... which also doesn't ship this class).
        -->
        <receiver
            android:name="com.vyze.app.debug.InteractionLogExportReceiver"
            android:exported="true" />

        <!--
            Shadow-route toggle (debug only): flips the in-process shadow
            flag so ROUTE decisions can be verified on-device via logcat.
            Process-local — every app restart restores default-dark.
        -->
        <receiver
            android:name="com.vyze.app.debug.ShadowRouteToggleReceiver"
            android:exported="true" />

        <!--
            VLM pre-gate toggle (debug only): flips the in-process pre-gate
            flag so IGNORE-family traffic can be verified as VLM-skipping on
            device via logcat ("VLM pre-gate:" lines). Process-local — every
            app restart restores default-dark.
        -->
        <receiver
            android:name="com.vyze.app.debug.PreGateToggleReceiver"
            android:exported="true" />

        <!--
            Auto-export provider (debug only). initOrder default; no
            authorities — every stub method returns null/0, nothing can
            query it. Multiprocess=false (default) keeps the export in the
            main process.
        -->
        <provider
            android:name="com.vyze.app.debug.TranscriptAutoExportProvider"
            android:authorities="${applicationId}.debug.transcriptautoexport"
            android:exported="false" />
    </application>

</manifest>
